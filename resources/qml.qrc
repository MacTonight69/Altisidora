<RCC>
    <qresource prefix="/">
        <file>qml/main.qml</file>
        <file alias="images/LogoAppLight.png">../images/LogoAppLight.png</file>
        <file alias="images/LogoAppDark.png">../images/LogoAppDark.png</file>
        <file alias="images/LogoAppRed.png">../images/LogoAppRed.png</file>
        <file alias="images/LogoAppYellow.png">../images/LogoAppYellow.png</file>
        <file>qml/components/PlayerControls.qml</file>
        <file>qml/components/SearchBar.qml</file>
        <file>qml/views/SongsView.qml</file>
        <file>qml/views/SongListDetailView.qml</file>
        <file>qml/views/AlbumsView.qml</file>
        <file>qml/views/ArtistsView.qml</file>
        <file>qml/views/PlaylistsView.qml</file>
        <file>qml/views/SettingsView.qml</file>
        <file>qml/themes/Theme.qml</file>
        <file>qml/themes/Themes.js</file>
    </qresource>
</RCC>
